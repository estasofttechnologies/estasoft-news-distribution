{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estasoft-nd/follow",
	"title": "Follow",
	"category": "widgets",
	"description": "The ways to follow your publication: a button to the address you choose, your RSS feed in the language of the page, and your Telegram, Apple News, Mastodon and Bluesky accounts.",
	"keywords": [ "follow", "subscribe", "rss", "feed", "news", "mastodon", "telegram", "bluesky", "apple news" ],
	"icon": "rss",
	"textdomain": "estasoft-news-distribution",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"followUrl": {
			"type": "string",
			"default": ""
		},
		"followLabel": {
			"type": "string",
			"default": ""
		},
		"showFeed": {
			"type": "boolean",
			"default": true
		},
		"showTelegram": {
			"type": "boolean",
			"default": true
		},
		"showAppleNews": {
			"type": "boolean",
			"default": true
		},
		"showMastodon": {
			"type": "boolean",
			"default": true
		},
		"showBluesky": {
			"type": "boolean",
			"default": true
		},
		"layout": {
			"type": "string",
			"enum": [ "buttons", "list" ],
			"default": "buttons"
		},
		"language": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "estasoft-nd-editor-follow",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css"
}
